        <ui:VisualElement name="Botones" class="botones" style="flex-grow: 0; background-color: rgba(95, 95, 95, 0.44); align-content: center; justify-content: center; width: 1100px; height: 800px; margin-top: 30px; margin-bottom: 30px; margin-right: 20px; margin-left: 20px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px;">
