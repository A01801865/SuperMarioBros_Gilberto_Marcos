        <ui:Button text="X" name="BotonCerrarJuego" style="align-self: flex-start; left: 10px; font-size: 30px; width: 50px; -unity-font-style: bold; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
