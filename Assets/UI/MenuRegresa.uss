.boton {
    background-image: url("project://database/Assets/FreeButtonSet/Textures/buttons/button_100.png?fileID=2800000&guid=47eaa4f43430bf14f996b113a313b0cc&type=3#button_100");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(76, 76, 76, 0);
    border-right-color: rgba(76, 76, 76, 0);
    border-top-color: rgba(76, 76, 76, 0);
    border-bottom-color: rgba(76, 76, 76, 0);
    width: 160px;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}

.boton:hover {
    scale: 1.1 1.1 1.1;
    -unity-font-style: normal;
}
